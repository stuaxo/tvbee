# Copy to .env (in the directory you run tveee from) or to
# ~/.config/tveee/env, and edit. Variables already set in your shell win.
# Only TV_* and TVEEE_* keys are read.

# The TV's address on your network
TV_IP=192.168.1.19

# Force vendor plugins on or off (otherwise detected and cached per TV)
#TVEEE_PLUGINS=philips

# A debug log: adb and HTTPS calls with their timings, and failures
#TVEEE_LOG=/tmp/tveee.log

# Kodi's files on this computer, for the ui's preview to show frames of what
# Kodi plays (needs ffmpeg) instead of its artwork: Kodi's path=local path,
# ;-separated
#TVEEE_KODI_PATHS=smb://nas/media=/mnt/nas/media
