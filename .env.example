# Copy to .env (in the directory you run tvbee from) or to
# ~/.config/tvbee/env, and edit. Variables already set in your shell win.
# Only TV_* and TVBEE_* keys are read.

# The TV's address on your network
TV_IP=192.168.1.19

# Force vendor plugins on or off (otherwise detected and cached per TV)
#TVBEE_PLUGINS=philips

# Where `tvbee debloat` finds its script (default: ./scripts/tv-debloat.sh)
#TV_DEBLOAT=/path/to/tv-debloat.sh
